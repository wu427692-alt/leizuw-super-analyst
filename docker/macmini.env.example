# Deployment parameters ONLY. Never put API/account keys in this file.
# Copy outside project/ as a private macmini.env. Required blank values fail
# Compose interpolation until explicitly configured for the restored bundle.
# Application credentials belong in runtime/config/.env (not printed by config).
# Prepare that effective private file offline from root .env then cloud-config/.env
# (cloud values win); the separate runtime/.env is NOT automatically loaded.
DSA_MACMINI_RUNTIME_DIR=
# Linux named-volume mode: add docker-compose.macmini-volumes.yml AFTER the base.
# Required only for that overlay: the seven <prefix>_<directory> volumes must
# already exist, be restored/verified and support UID/GID 1000 permissions.
# No volumes are created by Compose and no image data are copied into them.
# DSA_MACMINI_RUNTIME_DIR is still required for base-file interpolation; use a
# private restore staging path. Final overlaid services do not bind that path.
# Uncomment and fill only when enabling the Linux-volume overlay:
# DSA_MACMINI_VOLUME_PREFIX=
DSA_MACMINI_IMAGE=
DSA_MACMINI_PROJECT_NAME=dsa-macmini
DSA_MACMINI_HOST_PORT=18000
DSA_MACMINI_API_PORT=8000
DSA_MACMINI_TZ=Asia/Shanghai
DSA_MACMINI_RESTART_POLICY=no

# M4 / 16 GiB host with a native ARM VM allocated 4 CPU / 8 GiB.
# These tune capacity, not freshness or authentication. They do not start jobs.
# Web + collector limits total 6.5 GiB; leave 1.5 GiB for VM/Docker/page cache.
# Keep ONE API process: extra Uvicorn workers would duplicate lifespan jobs.
DSA_MACMINI_SERVER_CPUS=3
DSA_MACMINI_SERVER_MEMORY=5g
DSA_MACMINI_COLLECTOR_CPUS=1
DSA_MACMINI_COLLECTOR_MEMORY=1536m
DSA_MACMINI_TASK_WORKERS=2
DSA_MACMINI_SOURCE_WORKERS=4
DSA_MACMINI_ESSAY_CONCURRENCY=2
DSA_MACMINI_DOWNLOAD_WORKERS=2
DSA_MACMINI_PRICE_WORKERS=4
DSA_MACMINI_GENERATION_CONCURRENCY=2
DSA_MACMINI_WARMUP_DELAY_SECONDS=2
DSA_MACMINI_WARMUP_WORKERS=2
DSA_MACMINI_WATCHLIST_WARMUP_WORKERS=3
# Page cache is per connection, not per process: API up to (8+4)*32 MiB;
# collector up to 4*16 MiB. mmap maps only a window, not the entire DB into RAM.
DSA_MACMINI_SQLITE_CACHE_KIB=32768
DSA_MACMINI_SQLITE_MMAP_MB=512
DSA_MACMINI_SQLITE_POOL_SIZE=8
DSA_MACMINI_SQLITE_MAX_OVERFLOW=4
DSA_MACMINI_COLLECTOR_CACHE_KIB=16384
DSA_MACMINI_COLLECTOR_MMAP_MB=256
DSA_MACMINI_COLLECTOR_POOL_SIZE=4

# Safe preview: no startup AI/backfill/collectors and no external network.
# Preview APIs can still write locally on explicit requests; use a restored copy.
DSA_MACMINI_LIFESPAN=off
DSA_MACMINI_NETWORK_INTERNAL=true
DSA_MACMINI_COLLECTOR_ENABLED=false
DSA_MACMINI_PRODUCTION_CONFIRMED=false
DSA_MACMINI_LIVE_JOBS=false
DSA_MACMINI_CONFIG_READ_ONLY=true
DSA_MACMINI_TYC_READ_ONLY=true

# After authorized cutover and stopping the old writers, explicitly choose:
# - NETWORK_INTERNAL=false + COLLECTOR_ENABLED=true + --profile collector
#   to run only the existing investment-monitor daemon (includes report-library
#   synchronization). ZSXQ/CNINFO/AI/scheduling remain off.
# Full existing cloud worker set after approved cutover:
# DSA_MACMINI_NETWORK_INTERNAL=false
# DSA_MACMINI_COLLECTOR_ENABLED=true
# DSA_MACMINI_PRODUCTION_CONFIRMED=true
# DSA_MACMINI_LIFESPAN=on
# DSA_MACMINI_LIVE_JOBS=true
# DSA_MACMINI_RESTART_POLICY=unless-stopped
# DSA_MACMINI_CONFIG_READ_ONLY=false
# DSA_MACMINI_TYC_READ_ONLY=false
# Plus --profile collector. LIVE_JOBS restores market/essay analysis/daily reports/
# ZSXQ/CNINFO/watchdog/warmup in server and concept themes in monitor-worker.
# Lifespan on also resumes durable AI/quant/backfill queues. Existing cloud
# exclusions remain: essay quant precompute, storage maintenance, iCloud,
# market startup history bootstrap and scheduler automatic startup stay off.
# A server-only preview is not a complete production feature acceptance test.
# Preview config/ and tyc/ are read-only. Full production requires both false:
# the guard rejects live jobs with read-only mounts, and rejects writable private
# mounts unless PRODUCTION_CONFIRMED=true. This restores API setting saves and
# tyc credential refresh. Settings save creates config/.env.tmp then atomically
# replaces config/.env, so the whole config directory must be writable.
# Existing entrypoint does not repair these two directories. On the target only,
# prepare a RESTORED WORKING COPY for container UID/GID 1000 read/write access;
# do not alter the source or the verified archival bundle. Recreate containers
# after changing mount flags. Permission and CLI refresh acceptance remain live
# target-machine checks; these parameters do not change host permissions.
